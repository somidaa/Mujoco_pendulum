<mujoco model="simple_pendulum">

    <option timestep="0.002" integrator="RK4" gravity="0 0 -9.81">
        <flag energy="enable"/>
    </option>


    <worldbody>

        <!-- 地面 -->
        <geom
            name="ground"
            type="plane"
            size="5 5 0.1"
            pos="0 0 0"/>

        <!-- 摆（悬挂点抬高到 z=1.5，杆端不碰地面） -->
        <body name="pendulum" pos="0 0 1.5">

            <!-- 转动关节 -->
            <joint
                  name="hinge"
                  type="hinge"
                  axis="0 1 0"/>

            <!-- 摆杆（显式质量 0.3 kg，默认密度下杆会重达 ~8 kg 导致 PD 增益失效） -->
            <geom
                name="rod"
                type="capsule"
                fromto="0 0 0  0 0 -1"
                size="0.05"
                mass="0.3"/>

        </body>

    </worldbody>

    <actuator>

        <motor
            name="pendulum_motor"
            joint="hinge"
            gear="1"/>

    </actuator>

</mujoco>
